# --- SQLite ---
# The database is regenerated by `python -m src.ingester`, and in WAL mode
# SQLite writes .db-wal / .db-shm sidecars that change constantly.
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
d1_import.sql
d1_import/

