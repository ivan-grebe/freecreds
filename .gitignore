# --- SQLite ---
# The database is regenerated by `python -m freecreds.ingester`, and in WAL mode
# SQLite writes .db-wal / .db-shm sidecars that change constantly.
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
d1_import*.sql
d1_import*/
d1_cvc_import*/
tmp_cvc_seed.*

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

.claude/
