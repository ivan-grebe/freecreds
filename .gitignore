# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/

# --- Tool caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/
.wrangler/
.dev.vars
.env
.env.*
!.env.example
!.dev.vars.example
